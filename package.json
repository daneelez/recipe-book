{
  "name": "recipe-book",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "security:sast": "semgrep scan --config p/security-audit --config p/owasp-top-ten --config p/nodejs --config security/semgrep/custom-rules.yml .",
    "security:sca": "npm audit",
    "security:sca:report": "npm audit --json > security/reports/npm-audit.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.1.2"
  }
}
